{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "1.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",

  "browser_specific_settings": {
    "gecko": {
      "id": "wordrunner@extension",
      "strict_min_version": "78.0"
    }
  },

  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },

  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    },
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__"
  },

  "commands": {
    "start-reading": {
      "suggested_key": { "default": "Alt+W" },
      "description": "__MSG_commandStartReading__"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/wordprocessor.js", "lib/utils.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],

  "content_security_policy": "script-src 'self'; object-src 'self'"
}
