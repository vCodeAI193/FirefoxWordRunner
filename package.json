{
  "name": "word-runner",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "lint": "eslint lib/ popup.js background.js content.js",
    "check": "npm run lint && npm test",
    "coverage": "jest --coverage",
    "build": "zip -r word-runner.zip manifest.json icons/ _locales/ lib/ background.js content.js content.css popup.js popup.html popup.css"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
